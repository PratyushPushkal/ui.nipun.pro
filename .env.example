VITE_API_BASE_URL=http://localhost:5000/api
# Optional API client settings
# VITE_API_TIMEOUT_MS in milliseconds (default 15000)
VITE_API_TIMEOUT_MS=15000
# VITE_API_RETRY_COUNT for idempotent request retries (default 1)
VITE_API_RETRY_COUNT=1
# VITE_API_RETRY_DELAY_MS base delay in ms between retries (default 300)
VITE_API_RETRY_DELAY_MS=300
